[Unit]
Description=Uptime Kuma Container

[Container]
ContainerName=uptime-kuma
Image=ghcr.io/louislam/uptime-kuma:2-slim

# Enable auto-update container
AutoUpdate=registry

# DNS
AddHost=${DNS_HOST_1}
AddHost=${DNS_HOST_2}

Network=host

# pass this to attach it to container
Volume=%h/podman/uptime-kuma:/app/data

[Service]
EnvironmentFile=%h/.config/containers/systemd/uptime-kuma/.env
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target

