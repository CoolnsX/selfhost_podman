[Unit]
Description=Picard Container

[Container]
Pod=music.pod
ContainerName=picard
Image=ghcr.io/jlesage/musicbrainz-picard:latest

# Enable auto-update container
AutoUpdate=registry
Environment=USER_ID=${PUID}
Environment=GROUP_ID=${PGID}
Environment=TZ=${TZ}
#Environment=KEEP_APP_RUNNING=1
Environment=ENABLE_CJK_FONT=1
Environment=DARK_MODE=1

Volume=%h/podman/music/picard:/config
Volume=${DATA}:/storage

[Service]
EnvironmentFile=%h/.config/containers/systemd/music/.env
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target

