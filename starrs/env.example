PUID=1000 # set to 0 to run with podman rootless without uidmap
PGID=1000 # set to 0 to run with podman rootless without uidmap
TZ=Asia/Kolkata
DATA=/path/to/data
BACKUP=/path/to/backup

# log level
PROWLARR__LOG__LEVEL=warn
SONARR__LOG__LEVEL=warn
RADARR__LOG__LEVEL=warn

# tailscale
PROWLARR__AUTH__TRUSTCGNATIPADDRESSES=true
SONARR__AUTH__TRUSTCGNATIPADDRESSES=true
RADARR__AUTH__TRUSTCGNATIPADDRESSES=true
