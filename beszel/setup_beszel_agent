#!/bin/sh
set -eu

if [ "$(id -u)" -eq 0 ];then
    echo "Run as normal user, not root." >&2
    exit 1
fi

USER_NAME=$(id -un)
FILENAME="beszel-agent"
CONF="$HOME/.config/${FILENAME}"
BIN="/usr/local/bin/${FILENAME}"
SERVICE="/etc/systemd/system/${FILENAME}.service"
AUTO_UPDATE="/etc/systemd/system/${FILENAME}-update"

mkdir -p "$CONF"

printf 'Hub URL (e.g. https://beszel.example.com): '
read -r HUB_URL
printf 'Hub public key: '
read -r KEY
printf 'System token: '
read -r TOKEN

case "$(uname -m)" in
    x86_64) ARCH=amd64 ;;
    aarch64) ARCH=arm64 ;;
    *) echo "Unsupported architecture" >&2; exit 1 ;;
esac

TMP=$(mktemp -d)
trap "rm -rf '$TMP'" 0
trap 'exit 1' HUP INT TERM

curl -fsSL "https://github.com/henrygd/beszel/releases/latest/download/${FILENAME}_Linux_${ARCH}.tar.gz" -o - | tar -xzf - -C "$TMP" ${FILENAME}

[ -s "$TMP/$FILENAME" ] || exit 1

cat > "$CONF/agent.env" <<EOF
HUB_URL=$HUB_URL
KEY=$KEY
TOKEN=$TOKEN
DISABLE_SSH=true
LOG_LEVEL=warn
EXCLUDE_CONTAINERS="*-infra"
EOF

doas install -m 755 "$TMP/${FILENAME}" "$BIN"

doas tee "$SERVICE" >/dev/null <<EOF
[Unit]
Description=Beszel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=$USER_NAME
EnvironmentFile=$CONF/agent.env
ExecStart=$BIN
Restart=on-failure
RestartSec=5

# Security / sandboxing
KeyringMode=private
LockPersonality=yes
NoNewPrivileges=yes
ProtectClock=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectSystem=strict
RemoveIPC=yes
RestrictSUIDSGID=true
PrivateTmp=yes

AmbientCapabilities=CAP_SYS_RAWIO CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN

[Install]
WantedBy=multi-user.target
EOF

doas tee "${AUTO_UPDATE}.service" >/dev/null <<EOF
[Unit]
Description=Update Beszel Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=$BIN update
ExecStartPost=/usr/bin/systemctl try-restart ${FILENAME}.service
EOF

doas tee "${AUTO_UPDATE}.timer" >/dev/null <<EOF
[Unit]
Description=Daily Beszel Agent update

[Timer]
OnCalendar=daily
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
EOF

doas systemctl daemon-reload
doas systemctl enable --now "${FILENAME}.service" "${AUTO_UPDATE##*/}.timer"

echo "Beszel Agent with daily auto update service installed."
