[Unit]
Description=Opencloud Container

[Container]
ContainerName=opencloud
Image=quay.io/opencloudeu/opencloud-rolling:latest
Entrypoint=/bin/sh
Exec=-c "mkdir -p '/tmp/opencloud';opencloud init || true; opencloud server"

#Network=host
PublishPort=127.0.0.1:9200:9200
PublishPort=100.64.0.1:9200:9200

# this is required as opencloud won't work otherwise
AddHost=${DNSHOST1}

# Enable auto-update container
AutoUpdate=registry
# pass this to attach it to container
EnvironmentFile=./.env
EnvironmentFile=./unix.env

# metadata and configuration store here
Volume=%h/podman/opencloud/config:/etc/opencloud
Volume=%h/podman/opencloud/apps:/var/lib/opencloud/web/assets/apps

# actual data store here
Volume=${EXTERNAL_DIR}:/var/lib/opencloud

#to satisfy opencloud bitch permissions problems
UIDMap=1000:0:1
UIDMap=0:1:1000

[Service]
# pass this to autofill above variables
EnvironmentFile=%h/.config/containers/systemd/opencloud/.env
ExecStartPre=%h/scripts/oc_update_app no_restart
Restart=always
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target

